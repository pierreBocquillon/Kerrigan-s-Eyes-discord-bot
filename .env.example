# ---- Discord ----
DISCORD_BOT_TOKEN=
CLIENT_ID=
# Discord server where the commands are registered right away (otherwise: global commands, up to 1 h to show up)
GUILD_ID=
# port of the bot's HTTP server: health check (GET /) and Kerrigan's Eyes webhooks (POST /webhooks/ke)
PORT=3000

# ---- Kerrigan's Eyes integration (optional: leave KE_URL empty to disable it) ----
# Kerrigan's Eyes address seen from the bot (commands /status, /sessions, /campaigns)
KE_URL=
# Address seen from your browser ("Open in KE" buttons). Default: KE_URL
KE_PUBLIC_URL=
# Kerrigan's Eyes account used by the commands (a "guest" account is enough, it is read-only)
KE_USERNAME=
KE_PASSWORD=
# Discord channel where the notifications are posted (right click on the channel > Copy Channel ID)
KE_CHANNEL_ID=
# Webhook: in KE > Settings > Webhooks, add the URL http(s)://<bot address>:<PORT>/webhooks/ke
# then copy here the secret shown by KE.
KE_WEBHOOK_SECRET=
# Path of the webhook on the bot (default /webhooks/ke; "/" = at the root, GET / stays the health check)
KE_WEBHOOK_PATH=/webhooks/ke
# Optional: only this role can use /status, /sessions and /campaigns
KE_ROLE_ID=
