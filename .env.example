# ---- Discord ----
DISCORD_BOT_TOKEN=
CLIENT_ID=
# serveur Discord pour enregistrer les commandes instantanément (sinon : commandes globales, ~1 h de propagation)
GUILD_ID=
# port du serveur HTTP du bot : santé (GET /) et webhooks de Kerrigan's Eyes (POST /webhooks/ke)
PORT=3000

# ---- Intégration Kerrigan's Eyes (optionnelle : laisser KE_URL vide pour la désactiver) ----
# Adresse de Kerrigan's Eyes vue depuis le bot (commandes /status, /sessions, /campaigns)
KE_URL=
# Adresse vue depuis ton navigateur (boutons "Ouvrir dans KE"). Défaut : KE_URL
KE_PUBLIC_URL=
# Compte Kerrigan's Eyes utilisé par les commandes (un compte "guest" suffit, il est en lecture seule)
KE_USERNAME=
KE_PASSWORD=
# Salon Discord où poster les notifications (clic droit sur le salon > Copier l'identifiant)
KE_CHANNEL_ID=
# Webhook : dans KE > Settings > Webhooks, ajoute l'URL http(s)://<adresse du bot>:<PORT>/webhooks/ke
# puis copie ici le secret affiché par KE.
KE_WEBHOOK_SECRET=
# Chemin du webhook sur le bot (défaut /webhooks/ke ; "/" = à la racine, GET / reste le contrôle de santé)
KE_WEBHOOK_PATH=/webhooks/ke
# Optionnel : seul ce rôle peut utiliser /status, /sessions et /campaigns
KE_ROLE_ID=
